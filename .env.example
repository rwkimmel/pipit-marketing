# Supabase project URL for the dedicated Pipit marketing/commercial project.
SUPABASE_URL=

# Server-only credential for privileged inserts/upserts.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Postmark token for transactional early-access emails.
# Never expose this with a NEXT_PUBLIC_ prefix.
POSTMARK_SERVER_TOKEN=
